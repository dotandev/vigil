# --- NEAR ---------------------------------------------------------------
NEAR_NETWORK=testnet
VIGIL_CONTRACT_ID=vigil.<your-account>.testnet
VIGIL_OWNER=<owner>.testnet
AGENT_ACCOUNT_ID=<agent>.testnet
AGENT_PRIVATE_KEY=ed25519:...

# --- EVM ----------------------------------------------------------------
EVM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
EVM_CHAIN_ID=11155111
# Must be "<owner>/<name>"; defaults to "<VIGIL_OWNER>/ethereum-1".
# DERIVATION_PATH=owner.testnet/ethereum-1

# --- agent behaviour ----------------------------------------------------
POLL_MS=15000
# Don't spend gas ticking for less than 0.001 N of rent.
MIN_RENT_TO_TICK_YOCTO=1000000000000000000000
# Wei held back from the distribution to pay for the settlement itself.
GAS_RESERVE_WEI=2000000000000000
DRY_RUN=0

# --- optional: the agent's voice ---------------------------------------
# Used only to word reminders and notices. Never to decide anything.
# Leave unset and the agent uses fixed text instead.
# NEARAI_API_KEY=
# NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
# NEAR_AI_MODEL=deepseek-ai/DeepSeek-V3.1
